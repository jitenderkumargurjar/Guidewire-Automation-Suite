# .env
GW_BASE_URL=https://<your-guidewire-env>.guidewire.net/innovation
GW_USERNAME=<username>
GW_PASSWORD=<password>

# Everything else - state, effective date, line of business, customer name/address/contact,
# vehicle details, deductible, pay plan, and payment - comes from test-data/policies.xlsx instead
# of this file. One row = one policy; run "npm run policies:template" once to create a starter
# file if it doesn't exist yet. Credit Card/ACH payment detail entry isn't scripted, so a row
# using either of those pauses in-browser just for that step (everything else fills
# automatically).
